{
  "name": "yugorno-bot",
  "version": "0.6.1",
  "private": true,
  "description": "Telegram bot and responsive Mini App for Yugorno",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "test:browser": "node scripts/run-browser-tests.mjs",
    "test:all": "npm test && npm run test:browser",
    "reset:local-publications": "node scripts/clean-local-publications.js",
    "test:server": "node scripts/start-test-server.mjs"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "leaflet": "1.9.4",
    "leaflet.markercluster": "1.5.3",
    "playwright": "1.56.1"
  }
}
