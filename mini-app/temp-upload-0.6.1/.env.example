# Yugorno 0.6.1 production environment
# Enter the real bot token directly in Deployka. Never commit the real token.
NODE_ENV=production
BOT_TOKEN=paste_your_bot_token_here
BOT_USERNAME=YugornoTravelBot

# Set this to the public URL assigned by Deployka after the first deployment.
WEBAPP_URL=

# Attach a persistent volume in Deployka and confirm its mount path before using /data.
YUGORNO_DATA_DIR=/data
YUGORNO_UPLOAD_DIR=/data/uploads

# false means this server handles Telegram /start and other bot updates.
# Set true only if another known server is intentionally handling getUpdates.
DISABLE_BOT_POLLING=false

# Optional; defaults to 24 hours.
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400

# WhatsApp OTP is optional and is not required for Telegram Mini App login.
# SESSION_SECRET=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_API_VERSION=v22.0
# WHATSAPP_OTP_TEMPLATE=
# WHATSAPP_OTP_LANGUAGE=ru

# Comma-separated Telegram user IDs with full administrator access
YUGORNO_ADMIN_IDS=

# Comma-separated Telegram user IDs allowed to moderate content and edit featured destinations
YUGORNO_MODERATOR_IDS=
